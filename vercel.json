{
  "functions": {
    "src/app/api/cron/daily-summary/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/daily-digest/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/generate-column/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/refresh-international/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/warm-feeds/route.js": {
      "maxDuration": 60
    },
    "src/app/api/cron/rss-health/route.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/summary",
      "destination": "/digest",
      "permanent": true
    },
    {
      "source": "/world",
      "destination": "/category/world",
      "permanent": true
    },
    {
      "source": "/international",
      "destination": "/category/world",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-column",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/push-notify",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/breaking-news",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/refresh-international",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/warm-feeds",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/rss-health",
      "schedule": "0 5 * * *"
    }
  ]
}
